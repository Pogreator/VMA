{
	"$schema": "https://githubusercontent.com",
	"name": "VMA",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#builtins"
		},
		{
			"include": "#calls"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#variables"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.vma",
					"match": "//.*$"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"match": "\\b(Component)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
					"captures": {
						"1": {
							"name": "keyword.control.vma"
						},
						"2": {
							"name": "entity.name.type.vma"
						}
					}
				}
			]
		},
		"builtins": {
			"patterns": [
				{
					"name": "support.function.builtin.io.vma",
					"match": "\\b(INPUTS|OUTPUTS|NODES)\\b"
				},
				{
					"name": "support.function.builtin.gates.vma",
					"match": "\\b(NOT|AND|NAND|OR|NOR|XOR|XNOR)\\b"
				},
				{
					"name": "support.function.builtin.math.vma",
					"match": "\\b(ADDER|SUBTRACTOR|BITSHIFT|MULTIPLEXER)\\b"
				}
			]
		},
		"calls": {
			"patterns": [
				{
					"name": "entity.name.function.vma",
					"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\s*\\()"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.vma",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.vma",
					"match": "\\\\."
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.hex.vma",
					"match": "\\b0[xX][0-9a-fA-F]+\\b"
				},
				{
					"name": "constant.numeric.binary.vma",
					"match": "\\b0[bB][01]+\\b"
				},
				{
					"name": "constant.numeric.decimal.vma",
					"match": "\\b\\d+\\b"
				}
			]
		},
		"variables": {
			"patterns": [
				{
					"name": "variable.parameter.vma",
					"match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=[\\s,a-zA-Z0-9_]*=)"
				}
			]
		}
	},
	"scopeName": "source.vma"
}